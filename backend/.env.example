PORT=3001

# Cloudflare R2 credentials
# Get these from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=audioclip-files
R2_PUBLIC_URL=https://your-r2-public-url.r2.dev

# Restrict the API to yourself. Make up any long random string.
# When set, every request must send `Authorization: Bearer <this value>`.
# Leave blank ONLY for local development.
# Generate one with: openssl rand -hex 32
ALLOWED_TOKEN=
